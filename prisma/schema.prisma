generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum StoreStatus {
  DRAFT
  ACTIVE
  HIDDEN
  ARCHIVED
}

enum StoreCapability {
  COMMERCE
  NFC
  DIGITAL_PROFILE
  PET_PROFILE
  CHILD_SAFETY
  SOCIAL_PROFILE
  BUSINESS_PROFILE
  CUSTOM_PERSONALISATION
  PRINT_3D
  INVENTORY
}

enum StoreMembershipRole {
  CUSTOMER
  STAFF
  ADMIN
}

enum DeploymentEnvironment {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum AuthProvider {
  GOOGLE
  APPLE
  MICROSOFT
}

enum ProductType {
  PET
  CHILD
  EMERGENCY
  SOCIAL
  BUSINESS
  LUGGAGE
  REVIEW
  CUSTOM
  ACCESSORY
}

enum ProductStatus {
  DRAFT
  ACTIVE
  HIDDEN
  OUT_OF_STOCK
  ARCHIVED
}

enum CategoryStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  ARCHIVED
}

enum CategoryVisualTheme {
  CORAL
  SKY
  MIDNIGHT
  VIOLET
  AMBER
}

enum CategoryLandingLayout {
  EDITORIAL
  ASSURANCE
  EXECUTIVE
  MOMENTUM
  JOURNEY
}

enum CustomisationFieldType {
  SHORT_TEXT
  LONG_TEXT
  SELECT
  RADIO
  CHECKBOX
  COLOUR
  IMAGE
}

enum BackorderPolicy {
  DENY
  ALLOW
}

enum TagStatus {
  MANUFACTURED
  UNCLAIMED
  ACTIVE
  DISABLED
  LOST
  REPLACED
}

enum ChildStatus {
  NORMAL
  MISSING
}

enum SocialMode {
  DIRECT_REDIRECT
  MULTI_LINK
}

enum OrderStatus {
  PENDING
  PAYMENT_PENDING
  PAID
  PROCESSING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum ManufacturingStatus {
  GENERATED
  PROGRAMMED
  VERIFIED
  ASSEMBLED
  READY
  ASSIGNED
  SOLD
}

enum ManufacturingJobStatus {
  QUEUED
  PRINTING
  POST_PROCESSING
  QA
  ASSEMBLY
  PACKING
  READY
  FAILED
  CANCELLED
}

enum InventoryMovementType {
  RECEIPT
  RESERVATION
  RELEASE
  SALE
  RETURN
  ADJUSTMENT
}

model User {
  id                        String               @id @default(uuid()) @db.Uuid
  email                     String               @unique
  passwordHash              String?
  name                      String
  phone                     String?
  role                      Role                 @default(CUSTOMER)
  status                    AccountStatus        @default(ACTIVE)
  emailVerifiedAt           DateTime?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  addresses                 Address[]
  orders                    Order[]
  tags                      NFCTag[]
  sessions                  Session[]
  oauthAccounts             OAuthAccount[]
  carts                     Cart[]
  orderStatusChanges        OrderStatusHistory[] @relation("OrderStatusActor")
  inventoryChanges          InventoryMovement[]  @relation("InventoryActor")
  manufacturingBatches      ManufacturingBatch[] @relation("ManufacturingCreator")
  assignedManufacturingJobs ManufacturingJob[]   @relation("ManufacturingAssignee")
  auditLogs                 AuditLog[]
  emailTokens               EmailVerification[]
  passwordResets            PasswordReset[]
  storeMemberships          StoreMembership[]
}

model Store {
  id                   String               @id @default(uuid()) @db.Uuid
  slug                 String               @unique
  name                 String
  displayName          String
  legalName            String?
  status               StoreStatus          @default(DRAFT)
  logoUrl              String?
  faviconUrl           String?
  supportEmail         String?
  country              String               @default("AU") @db.Char(2)
  currency             String               @default("AUD") @db.Char(3)
  timezone             String               @default("Australia/Adelaide")
  theme                Json                 @default("{}")
  homepage             Json                 @default("{}")
  seoTitle             String
  seoDescription       String
  socialImageUrl       String?
  organization         Json                 @default("{}")
  socialLinks          Json                 @default("{}")
  shippingConfig       Json                 @default("{}")
  capabilities         StoreCapability[]    @default([])
  paymentProfileKey    String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  domains              StoreDomain[]
  memberships          StoreMembership[]
  sessions             Session[]
  emailTokens          EmailVerification[]
  passwordResets       PasswordReset[]
  categories           ProductCategory[]
  products             Product[]
  carts                Cart[]
  orders               Order[]
  tags                 NFCTag[]
  manufacturingBatches ManufacturingBatch[]
  manufacturingJobs    ManufacturingJob[]
  auditLogs            AuditLog[]

  @@index([status, name])
}

model StoreDomain {
  id          String                @id @default(uuid()) @db.Uuid
  storeId     String                @db.Uuid
  environment DeploymentEnvironment
  hostname    String
  protocol    String                @default("https")
  port        Int?
  isPrimary   Boolean               @default(false)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  store       Store                 @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@unique([environment, hostname])
  @@index([storeId, environment, isPrimary])
}

model StoreMembership {
  id                 String              @id @default(uuid()) @db.Uuid
  storeId            String              @db.Uuid
  userId             String              @db.Uuid
  role               StoreMembershipRole @default(CUSTOMER)
  marketingConsentAt DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  store              Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@index([userId, role])
}

model OAuthAccount {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @db.Uuid
  provider          AuthProvider
  providerAccountId String
  providerEmail     String?
  emailVerified     Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  storeId   String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  lastSeen  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@index([userId, storeId])
  @@index([expiresAt])
}

model EmailVerification {
  id           String    @id @default(uuid()) @db.Uuid
  tokenHash    String    @unique
  userId       String    @db.Uuid
  storeId      String    @db.Uuid
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  usedAt       DateTime?
  orderClaimId String?   @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  store        Store     @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@index([userId, storeId, expiresAt])
  @@index([orderClaimId])
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique
  userId    String    @db.Uuid
  storeId   String    @db.Uuid
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@index([userId, storeId, expiresAt])
}

model Address {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  label     String?
  recipient String
  line1     String
  line2     String?
  suburb    String
  state     String
  postcode  String
  country   String   @default("AU")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders    Order[]

  @@index([userId])
}

model Product {
  id               String               @id @default(uuid()) @db.Uuid
  storeId          String               @db.Uuid
  slug             String
  name             String
  description      String
  shortDescription String?
  fullDescription  String?              @db.Text
  type             ProductType
  status           ProductStatus        @default(DRAFT)
  featured         Boolean              @default(false)
  shopVisible      Boolean              @default(true)
  categoryId       String?              @db.Uuid
  seoTitle         String?
  seoDescription   String?
  ogImageUrl       String?
  canonicalUrl     String?
  indexable        Boolean              @default(true)
  brand            String               @default("Tapkin")
  gstInclusive     Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  category         ProductCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  store            Store                @relation(fields: [storeId], references: [id], onDelete: Restrict)
  variants         ProductVariant[]
  images           ProductImage[]
  options          ProductOption[]
  tags             NFCTag[]
  batches          ManufacturingBatch[]

  @@unique([storeId, slug])
  @@index([storeId, categoryId, status])
  @@index([storeId, status, featured])
}

model ProductCategory {
  id                  String                @id @default(uuid()) @db.Uuid
  storeId             String                @db.Uuid
  slug                String
  legacySlugs         String[]              @default([])
  name                String
  shortDescription    String?
  description         String?               @db.Text
  icon                String?
  imageUrl            String?
  cardTitle           String?
  cardText            String?
  cardImageUrl        String?
  cardImageAlt        String?
  heroEyebrow         String?
  heroHeadline        String?
  heroDescription     String?               @db.Text
  heroImageUrl        String?
  heroImageAlt        String?
  secondaryImageUrl   String?
  ctaLabel            String?
  ctaHref             String?
  secondaryCtaLabel   String?
  secondaryCtaHref    String?
  benefits            Json                  @default("[]")
  useCases            Json                  @default("[]")
  howItWorks          Json                  @default("[]")
  contentSections     Json                  @default("[]")
  faq                 Json                  @default("[]")
  finalCtaEyebrow     String?
  finalCtaHeadline    String?
  finalCtaDescription String?               @db.Text
  finalCtaLabel       String?
  finalCtaHref        String?
  visualTheme         CategoryVisualTheme   @default(CORAL)
  landingLayout       CategoryLandingLayout @default(EDITORIAL)
  status              CategoryStatus        @default(DRAFT)
  sortOrder           Int                   @default(0)
  showOnHomepage      Boolean               @default(true)
  showInNavigation    Boolean               @default(true)
  showInShop          Boolean               @default(true)
  showLanding         Boolean               @default(true)
  seoTitle            String?
  seoDescription      String?
  ogImageUrl          String?
  canonicalUrl        String?
  indexable           Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  products            Product[]
  store               Store                 @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@unique([storeId, slug])
  @@index([storeId, status, sortOrder])
  @@index([storeId, status, showOnHomepage, sortOrder])
  @@index([storeId, status, showInNavigation, sortOrder])
  @@index([storeId, status, showInShop, sortOrder])
  @@index([legacySlugs], type: Gin)
}

model ProductImage {
  id         String           @id @default(uuid()) @db.Uuid
  productId  String           @db.Uuid
  storageKey String           @unique
  url        String
  altText    String
  mimeType   String
  byteSize   Int
  width      Int?
  height     Int?
  sortOrder  Int              @default(0)
  isPrimary  Boolean          @default(false)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  product    Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants   ProductVariant[] @relation("VariantImage")

  @@index([productId, sortOrder])
}

model ProductOption {
  id              String                 @id @default(uuid()) @db.Uuid
  productId       String                 @db.Uuid
  name            String
  code            String
  type            CustomisationFieldType
  required        Boolean                @default(false)
  maxLength       Int?
  priceDeltaCents Int                    @default(0)
  sortOrder       Int                    @default(0)
  active          Boolean                @default(true)
  helpText        String?
  product         Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  values          ProductOptionValue[]

  @@unique([productId, code])
  @@index([productId, active, sortOrder])
}

model ProductOptionValue {
  id              String        @id @default(uuid()) @db.Uuid
  optionId        String        @db.Uuid
  label           String
  value           String
  priceDeltaCents Int           @default(0)
  sortOrder       Int           @default(0)
  active          Boolean       @default(true)
  option          ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([optionId, value])
  @@index([optionId, active, sortOrder])
}

model ProductVariant {
  id                  String               @id @default(uuid()) @db.Uuid
  productId           String               @db.Uuid
  sku                 String               @unique
  name                String
  colour              String?
  size                String?
  material            String?
  priceCents          Int
  compareAtPriceCents Int?
  costCents           Int?
  inventory           Int                  @default(0)
  reservedInventory   Int                  @default(0)
  trackInventory      Boolean              @default(true)
  lowStockThreshold   Int                  @default(5)
  backorderPolicy     BackorderPolicy      @default(DENY)
  imageId             String?              @db.Uuid
  active              Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  product             Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  image               ProductImage?        @relation("VariantImage", fields: [imageId], references: [id], onDelete: SetNull)
  orderItems          OrderItem[]
  cartItems           CartItem[]
  tags                NFCTag[]
  batches             ManufacturingBatch[]
  inventoryMovements  InventoryMovement[]
  manufacturingJobs   ManufacturingJob[]

  @@index([productId, active])
  @@index([trackInventory, inventory])
}

model Cart {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String?    @db.Uuid
  storeId        String     @db.Uuid
  sessionKeyHash String?    @unique
  currency       String     @default("AUD")
  expiresAt      DateTime
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  user           User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  store          Store      @relation(fields: [storeId], references: [id], onDelete: Restrict)
  items          CartItem[]

  @@index([storeId, userId, updatedAt])
  @@index([expiresAt])
}

model CartItem {
  id              String         @id @default(uuid()) @db.Uuid
  cartId          String         @db.Uuid
  variantId       String         @db.Uuid
  quantity        Int
  personalisation Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  cart            Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([cartId])
  @@index([variantId])
}

model Order {
  id                  String                @id @default(uuid()) @db.Uuid
  orderNumber         String                @unique
  userId              String?               @db.Uuid
  storeId             String                @db.Uuid
  sourceDomain        String
  checkoutEnvironment DeploymentEnvironment
  storeDisplayName    String
  guestEmail          String?
  customerName        String?
  claimTokenHash      String?               @unique
  claimExpiresAt      DateTime?
  claimedAt           DateTime?
  shippingAddressId   String?               @db.Uuid
  shippingName        String?
  shippingLine1       String?
  shippingLine2       String?
  shippingSuburb      String?
  shippingState       String?
  shippingPostcode    String?
  shippingCountry     String                @default("AU")
  shippingCarrier     String?
  trackingNumber      String?
  shippedAt           DateTime?
  status              OrderStatus           @default(PENDING)
  currency            String                @default("AUD")
  subtotalCents       Int
  shippingCents       Int                   @default(0)
  totalCents          Int
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  user                User?                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  store               Store                 @relation(fields: [storeId], references: [id], onDelete: Restrict)
  shippingAddress     Address?              @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  payments            Payment[]
  statusHistory       OrderStatusHistory[]
  inventoryMovements  InventoryMovement[]

  @@index([storeId, userId, createdAt])
  @@index([storeId, guestEmail, createdAt])
  @@index([storeId, status, createdAt])
  @@index([trackingNumber])
}

model OrderItem {
  id                String             @id @default(uuid()) @db.Uuid
  orderId           String             @db.Uuid
  variantId         String             @db.Uuid
  quantity          Int
  unitPriceCents    Int
  productName       String
  variantName       String
  sku               String
  productType       ProductType
  personalisation   Json?
  order             Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant           ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Restrict)
  tags              NFCTag[]
  manufacturingJobs ManufacturingJob[]

  @@index([orderId])
}

model OrderStatusHistory {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @db.Uuid
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorId    String?      @db.Uuid
  note       String?
  createdAt  DateTime     @default(now())
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor      User?        @relation("OrderStatusActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model InventoryMovement {
  id        String                @id @default(uuid()) @db.Uuid
  variantId String                @db.Uuid
  orderId   String?               @db.Uuid
  actorId   String?               @db.Uuid
  type      InventoryMovementType
  quantity  Int
  reason    String?
  createdAt DateTime              @default(now())
  variant   ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Restrict)
  order     Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  actor     User?                 @relation("InventoryActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@index([orderId])
}

model ManufacturingBatch {
  id               String              @id @default(uuid()) @db.Uuid
  batchNumber      String              @unique
  storeId          String              @db.Uuid
  productId        String              @db.Uuid
  productVariantId String?             @db.Uuid
  quantity         Int
  status           ManufacturingStatus @default(GENERATED)
  createdById      String?             @db.Uuid
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  product          Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  store            Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  productVariant   ProductVariant?     @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  createdBy        User?               @relation("ManufacturingCreator", fields: [createdById], references: [id], onDelete: SetNull)
  tags             NFCTag[]

  @@index([storeId, status, createdAt])
  @@index([storeId, productId, createdAt])
}

model ManufacturingJob {
  id               String                 @id @default(uuid()) @db.Uuid
  storeId          String                 @db.Uuid
  orderItemId      String                 @db.Uuid
  productVariantId String                 @db.Uuid
  sequence         Int                    @default(1)
  quantity         Int
  status           ManufacturingJobStatus @default(QUEUED)
  priority         Int                    @default(0)
  material         String?
  colour           String?
  requiresNfc      Boolean                @default(false)
  estimatedMinutes Int?
  actualMinutes    Int?
  qaPassed         Boolean?
  failureReason    String?
  assignedToId     String?                @db.Uuid
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  store            Store                  @relation(fields: [storeId], references: [id], onDelete: Restrict)
  orderItem        OrderItem              @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  productVariant   ProductVariant         @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  assignedTo       User?                  @relation("ManufacturingAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@unique([orderItemId, sequence])
  @@index([storeId, status, priority, createdAt])
  @@index([productVariantId, status])
  @@index([assignedToId, status])
}

model Payment {
  id                      String        @id @default(uuid()) @db.Uuid
  orderId                 String        @db.Uuid
  provider                String        @default("stripe")
  providerPaymentIntentId String?       @unique
  providerSessionId       String?       @unique
  amountCents             Int
  currency                String        @default("AUD")
  status                  PaymentStatus @default(PENDING)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  order                   Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

model NFCTag {
  id                          String              @id @default(uuid()) @db.Uuid
  publicTagId                 String              @unique @db.VarChar(24)
  storeId                     String              @db.Uuid
  activationCodeHash          String
  activationCodeVersion       Int                 @default(1)
  activationCodeRegeneratedAt DateTime?
  activationLockedUntil       DateTime?
  ownerId                     String?             @db.Uuid
  productId                   String              @db.Uuid
  productVariantId            String?             @db.Uuid
  orderItemId                 String?             @db.Uuid
  productType                 ProductType
  status                      TagStatus           @default(MANUFACTURED)
  manufacturingStatus         ManufacturingStatus @default(GENERATED)
  manufacturingBatchId        String?             @db.Uuid
  batchSequence               Int?
  programmedAt                DateTime?
  verifiedAt                  DateTime?
  assembledAt                 DateTime?
  activatedAt                 DateTime?
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
  owner                       User?               @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  store                       Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product                     Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  productVariant              ProductVariant?     @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  orderItem                   OrderItem?          @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  manufacturingBatch          ManufacturingBatch? @relation(fields: [manufacturingBatchId], references: [id], onDelete: SetNull)
  activations                 TagActivation[]
  profile                     TagProfile?
  scans                       ScanEvent[]

  @@unique([manufacturingBatchId, batchSequence])
  @@index([storeId, ownerId, status])
  @@index([storeId, productId, status])
  @@index([orderItemId])
  @@index([manufacturingStatus, createdAt])
}

model TagActivation {
  id          String   @id @default(uuid()) @db.Uuid
  tagId       String   @db.Uuid
  userId      String?  @db.Uuid
  success     Boolean
  ipHash      String?
  attemptedAt DateTime @default(now())
  tag         NFCTag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@index([tagId, attemptedAt])
  @@index([ipHash, attemptedAt])
}

model TagProfile {
  id          String             @id @default(uuid()) @db.Uuid
  tagId       String             @unique @db.Uuid
  displayName String?
  isPublic    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  tag         NFCTag             @relation(fields: [tagId], references: [id], onDelete: Cascade)
  pet         PetProfile?
  child       ChildProfile?
  social      SocialProfile?
  business    BusinessProfile?
  luggage     LuggageProfile?
  contacts    EmergencyContact[]
}

model PetProfile {
  id             String     @id @default(uuid()) @db.Uuid
  tagProfileId   String     @unique @db.Uuid
  photoUrl       String?
  species        String?
  breed          String?
  sex            String?
  approximateAge String?
  description    String?
  medicalInfo    String?
  allergies      String?
  medications    String?
  behaviourNotes String?
  veterinarian   String?
  tagProfile     TagProfile @relation(fields: [tagProfileId], references: [id], onDelete: Cascade)
}

model ChildProfile {
  id                  String      @id @default(uuid()) @db.Uuid
  tagProfileId        String      @unique @db.Uuid
  photoUrl            String?
  approximateAge      String?
  criticalMedicalInfo String?
  allergies           String?
  communicationNotes  String?
  status              ChildStatus @default(NORMAL)
  tagProfile          TagProfile  @relation(fields: [tagProfileId], references: [id], onDelete: Cascade)
}

model SocialProfile {
  id           String     @id @default(uuid()) @db.Uuid
  tagProfileId String     @unique @db.Uuid
  mode         SocialMode @default(MULTI_LINK)
  redirectUrl  String?
  links        Json       @default("{}")
  bio          String?
  tagProfile   TagProfile @relation(fields: [tagProfileId], references: [id], onDelete: Cascade)
}

model BusinessProfile {
  id           String     @id @default(uuid()) @db.Uuid
  tagProfileId String     @unique @db.Uuid
  company      String?
  jobTitle     String?
  phone        String?
  email        String?
  website      String?
  linkedIn     String?
  socialLinks  Json       @default("{}")
  bio          String?
  tagProfile   TagProfile @relation(fields: [tagProfileId], references: [id], onDelete: Cascade)
}

model LuggageProfile {
  id           String     @id @default(uuid()) @db.Uuid
  tagProfileId String     @unique @db.Uuid
  message      String?
  contactName  String?
  contactPhone String?
  contactEmail String?
  tagProfile   TagProfile @relation(fields: [tagProfileId], references: [id], onDelete: Cascade)
}

model EmergencyContact {
  id           String     @id @default(uuid()) @db.Uuid
  tagProfileId String     @db.Uuid
  name         String
  relationship String?
  phone        String
  priority     Int        @default(0)
  tagProfile   TagProfile @relation(fields: [tagProfileId], references: [id], onDelete: Cascade)

  @@index([tagProfileId, priority])
}

model ScanEvent {
  id             BigInt   @id @default(autoincrement())
  tagId          String   @db.Uuid
  scannedAt      DateTime @default(now())
  dayBucket      DateTime @db.Date
  deviceCategory String?
  countryCode    String?  @db.Char(2)
  region         String?
  tag            NFCTag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@index([tagId, scannedAt])
  @@index([tagId, dayBucket])
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @db.Uuid
  storeId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  store      Store?   @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([storeId, createdAt])
  @@index([entityType, entityId])
}

model WebhookEvent {
  id          String   @id
  provider    String
  eventType   String
  processedAt DateTime @default(now())
}

model SecurityEvent {
  id        BigInt   @id @default(autoincrement())
  keyHash   String
  action    String
  createdAt DateTime @default(now())

  @@index([keyHash, action, createdAt])
}

model StoreSettings {
  id                    String   @id @default("default")
  storeName             String   @default("Tapkin")
  businessName          String?
  supportEmail          String?
  currency              String   @default("AUD")
  defaultCountry        String   @default("AU")
  siteTitle             String   @default("Tapkin Smart Products")
  siteDescription       String   @default("Smart NFC products designed and made in Australia.")
  defaultSocialImageUrl String?
  socialLinks           Json     @default("{}")
  shippingConfig        Json     @default("{}")
  updatedAt             DateTime @updatedAt
}
