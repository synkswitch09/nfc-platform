generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum StoreStatus {
  DRAFT
  ACTIVE
  HIDDEN
  ARCHIVED
}

enum StoreCapability {
  COMMERCE
  NFC
  DIGITAL_PROFILE
  PET_PROFILE
  CHILD_SAFETY
  SOCIAL_PROFILE
  BUSINESS_PROFILE
  CUSTOM_PERSONALISATION
  PRINT_3D
  INVENTORY
}

enum StoreMembershipRole {
  CUSTOMER
  STAFF
  ADMIN
}

enum DeploymentEnvironment {
  DEVELOPMENT
  STAGING
  PRODUCTION
  LEGACY
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum AuthProvider {
  GOOGLE
  APPLE
  MICROSOFT
}

enum ProductType {
  PET
  CHILD
  EMERGENCY
  SOCIAL
  BUSINESS
  LUGGAGE
  REVIEW
  CUSTOM
  ACCESSORY
}

enum ProductStatus {
  DRAFT
  ACTIVE
  HIDDEN
  OUT_OF_STOCK
  ARCHIVED
}

enum CategoryStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  ARCHIVED
}

enum CategoryVisualTheme {
  CORAL
  SKY
  MIDNIGHT
  VIOLET
  AMBER
}

enum CategoryLandingLayout {
  EDITORIAL
  ASSURANCE
  EXECUTIVE
  MOMENTUM
  JOURNEY
}

enum CustomisationFieldType {
  SHORT_TEXT
  LONG_TEXT
  SELECT
  RADIO
  CHECKBOX
  COLOUR
  IMAGE
}

enum BackorderPolicy {
  DENY
  ALLOW
}

enum PersonalisationMode {
  NONE
  OPTIONAL
  REQUIRED
}

enum PersonalisationChoice {
  BASIC
  PERSONALISED
}

enum ShippingProviderKind {
  MANUAL
  MOCK
  AUSTRALIA_POST
}

enum ShippingQuoteStatus {
  ACTIVE
  CONSUMED
  EXPIRED
}

enum ShipmentStatus {
  DRAFT
  LABEL_READY
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum PrintDocumentType {
  SHIPPING_LABEL
}

enum PrintJobStatus {
  QUEUED
  CLAIMED
  PRINTED
  FAILED
  CANCELLED
}

enum LandingSectionType {
  HERO
  FEATURE_BADGES
  BENEFITS
  STEPS
  PRODUCT_SHOWCASE
  FEATURE_LIST
  MEDIA_CONTENT
  STORY_PROCESS
  FAQ
  CTA_BANNER
  PRODUCT_GRID
  CATEGORY_GRID
  RICH_TEXT
  TRUST_STRIP
  STATS
}

enum ContentPageKind {
  HOME
  CATEGORY
  CAMPAIGN
  COLLECTION
  LEGAL
}

enum TagStatus {
  MANUFACTURED
  UNCLAIMED
  ACTIVE
  DISABLED
  LOST
  REPLACED
}

enum ChildStatus {
  NORMAL
  MISSING
}

enum SocialMode {
  DIRECT_REDIRECT
  MULTI_LINK
}

enum OrderStatus {
  PENDING
  PAYMENT_PENDING
  PAID
  PROCESSING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum ManufacturingStatus {
  GENERATED
  PROGRAMMED
  VERIFIED
  ASSEMBLED
  READY
  ASSIGNED
  SOLD
}

enum ManufacturingJobStatus {
  QUEUED
  PRINTING
  POST_PROCESSING
  QA
  ASSEMBLY
  PACKING
  READY
  FAILED
  CANCELLED
}

enum InventoryMovementType {
  RECEIPT
  RESERVATION
  RELEASE
  SALE
  RETURN
  ADJUSTMENT
}

model User {
  id                        String               @id @default(uuid()) @db.Uuid
  email                     String               @unique
  passwordHash              String?
  name                      String
  phone                     String?
  role                      Role                 @default(CUSTOMER)
  status                    AccountStatus        @default(ACTIVE)
  emailVerifiedAt           DateTime?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  addresses                 Address[]
  orders                    Order[]
  tags                      NFCTag[]
  sessions                  Session[]
  oauthAccounts             OAuthAccount[]
  carts                     Cart[]
  orderStatusChanges        OrderStatusHistory[] @relation("OrderStatusActor")
  inventoryChanges          InventoryMovement[]  @relation("InventoryActor")
  manufacturingBatches      ManufacturingBatch[] @relation("ManufacturingCreator")
  assignedManufacturingJobs ManufacturingJob[]   @relation("ManufacturingAssignee")
  auditLogs                 AuditLog[]
  emailTokens               EmailVerification[]
  passwordResets            PasswordReset[]
  storeMemberships          StoreMembership[]
  createdShippingOrigins    ShippingOrigin[]      @relation("ShippingOriginCreator")
  createdShipments          Shipment[]            @relation("ShipmentCreator")
  createdPrintAgents        PrintAgent[]          @relation("PrintAgentCreator")
}

model Store {
  id                   String               @id @default(uuid()) @db.Uuid
  slug                 String               @unique
  name                 String
  displayName          String
  legalName            String?
  status               StoreStatus          @default(DRAFT)
  logoUrl              String?
  faviconUrl           String?
  supportEmail         String?
  country              String               @default("AU") @db.Char(2)
  currency             String               @default("AUD") @db.Char(3)
  timezone             String               @default("Australia/Adelaide")
  theme                Json                 @default("{}")
  homepage             Json                 @default("{}")
  seoTitle             String
  seoDescription       String
  socialImageUrl       String?
  organization         Json                 @default("{}")
  socialLinks          Json                 @default("{}")
  shippingConfig       Json                 @default("{}")
  headerConfig         Json                 @default("{}")
  footerConfig         Json                 @default("{}")
  defaultLocale        String               @default("en-AU")
  enabledLocales       String[]             @default(["en-AU"])
  capabilities         StoreCapability[]    @default([])
  paymentProfileKey    String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  domains              StoreDomain[]
  memberships          StoreMembership[]
  sessions             Session[]
  emailTokens          EmailVerification[]
  passwordResets       PasswordReset[]
  categories           ProductCategory[]
  products             Product[]
  categoryImages       CategoryImage[]
  contentPages         ContentPage[]
  locales              StoreLocale[]
  carts                Cart[]
  orders               Order[]
  tags                 NFCTag[]
  manufacturingBatches ManufacturingBatch[]
  manufacturingJobs    ManufacturingJob[]
  auditLogs            AuditLog[]
  shippingOrigins      ShippingOrigin[]
  packaging            Packaging[]
  shippingZones        ShippingZone[]
  shippingProviders    ShippingProvider[]
  shippingRates        ShippingRate[]
  shippingQuotes       ShippingQuote[]
  shipments            Shipment[]
  printAgents          PrintAgent[]
  printJobs            PrintJob[]
  landingSections      LandingPageSection[]

  @@index([status, name])
}

model StoreDomain {
  id          String                @id @default(uuid()) @db.Uuid
  storeId     String                @db.Uuid
  environment DeploymentEnvironment
  hostname    String
  protocol    String                @default("https")
  port        Int?
  isPrimary   Boolean               @default(false)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  store       Store                 @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@unique([environment, hostname])
  @@index([storeId, environment, isPrimary])
}

model StoreMembership {
  id                 String              @id @default(uuid()) @db.Uuid
  storeId            String              @db.Uuid
  userId             String              @db.Uuid
  role               StoreMembershipRole @default(CUSTOMER)
  marketingConsentAt DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  store              Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@index([userId, role])
}

model OAuthAccount {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @db.Uuid
  provider          AuthProvider
  providerAccountId String
  providerEmail     String?
  emailVerified     Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  storeId   String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  lastSeen  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@index([userId, storeId])
  @@index([expiresAt])
}

model EmailVerification {
  id           String    @id @default(uuid()) @db.Uuid
  tokenHash    String    @unique
  userId       String    @db.Uuid
  storeId      String    @db.Uuid
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  usedAt       DateTime?
  orderClaimId String?   @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  store        Store     @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@index([userId, storeId, expiresAt])
  @@index([orderClaimId])
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique
  userId    String    @db.Uuid
  storeId   String    @db.Uuid
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@index([userId, storeId, expiresAt])
}

model Address {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  label     String?
  recipient String
  line1     String
  line2     String?
  suburb    String
  state     String
  postcode  String
  country   String   @default("AU")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders    Order[]

  @@index([userId])
}

model Product {
  id               String               @id @default(uuid()) @db.Uuid
  storeId          String               @db.Uuid
  slug             String
  name             String
  description      String
  shortDescription String?
  fullDescription  String?              @db.Text
  type             ProductType
  status           ProductStatus        @default(DRAFT)
  featured         Boolean              @default(false)
  shopVisible      Boolean              @default(true)
  categoryId       String?              @db.Uuid
  seoTitle         String?
  seoDescription   String?
  ogImageUrl       String?
  canonicalUrl     String?
  indexable        Boolean              @default(true)
  brand            String
  gstInclusive     Boolean              @default(true)
  personalisationMode PersonalisationMode @default(NONE)
  weightGrams      Int?
  lengthMm         Int?
  widthMm          Int?
  heightMm         Int?
  defaultPackagingId String?            @db.Uuid
  shipsSeparately  Boolean              @default(false)
  specialHandling  String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  category         ProductCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  store            Store                @relation(fields: [storeId], references: [id], onDelete: Restrict)
  variants         ProductVariant[]
  images           ProductImage[]
  options          ProductOption[]
  tags             NFCTag[]
  batches          ManufacturingBatch[]
  defaultPackaging Packaging?           @relation(fields: [defaultPackagingId], references: [id], onDelete: SetNull)

  @@unique([storeId, slug])
  @@index([storeId, categoryId, status])
  @@index([storeId, status, featured])
}

model ProductCategory {
  id                  String                @id @default(uuid()) @db.Uuid
  storeId             String                @db.Uuid
  slug                String
  legacySlugs         String[]              @default([])
  name                String
  shortDescription    String?
  description         String?               @db.Text
  icon                String?
  imageUrl            String?
  cardTitle           String?
  cardText            String?
  cardImageUrl        String?
  cardImageAlt        String?
  heroEyebrow         String?
  heroHeadline        String?
  heroDescription     String?               @db.Text
  heroImageUrl        String?
  heroImageAlt        String?
  secondaryImageUrl   String?
  ctaLabel            String?
  ctaHref             String?
  secondaryCtaLabel   String?
  secondaryCtaHref    String?
  benefits            Json                  @default("[]")
  useCases            Json                  @default("[]")
  howItWorks          Json                  @default("[]")
  contentSections     Json                  @default("[]")
  faq                 Json                  @default("[]")
  finalCtaEyebrow     String?
  finalCtaHeadline    String?
  finalCtaDescription String?               @db.Text
  finalCtaLabel       String?
  finalCtaHref        String?
  visualTheme         CategoryVisualTheme   @default(CORAL)
  landingLayout       CategoryLandingLayout @default(EDITORIAL)
  status              CategoryStatus        @default(DRAFT)
  sortOrder           Int                   @default(0)
  showOnHomepage      Boolean               @default(true)
  showInNavigation    Boolean               @default(true)
  showInShop          Boolean               @default(true)
  showLanding         Boolean               @default(true)
  seoTitle            String?
  seoDescription      String?
  ogImageUrl          String?
  canonicalUrl        String?
  indexable           Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  products            Product[]
  store               Store                 @relation(fields: [storeId], references: [id], onDelete: Restrict)
  landingSections     LandingPageSection[]
  images              CategoryImage[]
  contentPage         ContentPage?

  @@unique([storeId, slug])
  @@index([storeId, status, sortOrder])
  @@index([storeId, status, showOnHomepage, sortOrder])
  @@index([storeId, status, showInNavigation, sortOrder])
  @@index([storeId, status, showInShop, sortOrder])
  @@index([legacySlugs], type: Gin)
}

model ProductImage {
  id         String           @id @default(uuid()) @db.Uuid
  productId  String           @db.Uuid
  storageKey String           @unique
  url        String
  altText    String
  mimeType   String
  byteSize   Int
  width      Int?
  height     Int?
  sortOrder  Int              @default(0)
  isPrimary  Boolean          @default(false)
  optionValueId String?       @db.Uuid
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  product    Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants   ProductVariant[] @relation("VariantImage")
  optionValue ProductOptionValue? @relation(fields: [optionValueId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
  @@index([productId, optionValueId, sortOrder])
}

model CategoryImage {
  id         String          @id @default(uuid()) @db.Uuid
  storeId    String          @db.Uuid
  categoryId String?         @db.Uuid
  pageId     String?         @db.Uuid
  storageKey String          @unique
  url        String
  altText    String?
  purpose    String          @default("content-image")
  mimeType   String
  byteSize   Int
  width      Int
  height     Int
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  store      Store           @relation(fields: [storeId], references: [id], onDelete: Restrict)
  category   ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  page       ContentPage?    @relation(fields: [pageId], references: [id], onDelete: SetNull)

  @@index([storeId, categoryId, createdAt])
  @@index([storeId, pageId, createdAt])
}

model ProductOption {
  id              String                 @id @default(uuid()) @db.Uuid
  productId       String                 @db.Uuid
  name            String
  code            String
  type            CustomisationFieldType
  required        Boolean                @default(false)
  maxLength       Int?
  priceDeltaCents Int                    @default(0)
  sortOrder       Int                    @default(0)
  active          Boolean                @default(true)
  helpText        String?
  product         Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  values          ProductOptionValue[]

  @@unique([productId, code])
  @@index([productId, active, sortOrder])
}

model ProductOptionValue {
  id              String        @id @default(uuid()) @db.Uuid
  optionId        String        @db.Uuid
  label           String
  value           String
  priceDeltaCents Int           @default(0)
  sortOrder       Int           @default(0)
  active          Boolean       @default(true)
  swatchHex       String?
  swatchHexSecondary String?
  swatchImageUrl  String?
  option          ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  images          ProductImage[]

  @@unique([optionId, value])
  @@index([optionId, active, sortOrder])
}

model ProductVariant {
  id                  String               @id @default(uuid()) @db.Uuid
  productId           String               @db.Uuid
  sku                 String               @unique
  name                String
  colour              String?
  size                String?
  material            String?
  priceCents          Int
  compareAtPriceCents Int?
  costCents           Int?
  inventory           Int                  @default(0)
  reservedInventory   Int                  @default(0)
  trackInventory      Boolean              @default(true)
  lowStockThreshold   Int                  @default(5)
  backorderPolicy     BackorderPolicy      @default(DENY)
  imageId             String?              @db.Uuid
  active              Boolean              @default(true)
  isDefault           Boolean              @default(false)
  optionSelection     Json                 @default("{}")
  weightGrams         Int?
  lengthMm            Int?
  widthMm             Int?
  heightMm            Int?
  defaultPackagingId  String?              @db.Uuid
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  product             Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  image               ProductImage?        @relation("VariantImage", fields: [imageId], references: [id], onDelete: SetNull)
  orderItems          OrderItem[]
  cartItems           CartItem[]
  tags                NFCTag[]
  batches             ManufacturingBatch[]
  inventoryMovements  InventoryMovement[]
  manufacturingJobs   ManufacturingJob[]
  defaultPackaging    Packaging?           @relation(fields: [defaultPackagingId], references: [id], onDelete: SetNull)

  @@index([productId, active])
  @@index([trackInventory, inventory])
}

model Cart {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String?    @db.Uuid
  storeId        String     @db.Uuid
  sessionKeyHash String?    @unique
  currency       String     @default("AUD")
  expiresAt      DateTime
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  user           User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  store          Store      @relation(fields: [storeId], references: [id], onDelete: Restrict)
  items          CartItem[]

  @@index([storeId, userId, updatedAt])
  @@index([expiresAt])
}

model CartItem {
  id              String         @id @default(uuid()) @db.Uuid
  cartId          String         @db.Uuid
  variantId       String         @db.Uuid
  quantity        Int
  personalisation Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  cart            Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([cartId])
  @@index([variantId])
}

model Order {
  id                  String                @id @default(uuid()) @db.Uuid
  orderNumber         String                @unique
  userId              String?               @db.Uuid
  storeId             String                @db.Uuid
  sourceDomain        String
  checkoutEnvironment DeploymentEnvironment
  storeDisplayName    String
  guestEmail          String?
  customerName        String?
  claimTokenHash      String?               @unique
  claimExpiresAt      DateTime?
  claimedAt           DateTime?
  shippingAddressId   String?               @db.Uuid
  shippingName        String?
  shippingLine1       String?
  shippingLine2       String?
  shippingSuburb      String?
  shippingState       String?
  shippingPostcode    String?
  shippingCountry     String                @default("AU")
  shippingCarrier     String?
  trackingNumber      String?
  shippingProviderKey String?
  shippingServiceCode String?
  shippingServiceName String?
  shippingQuoteId     String?               @unique @db.Uuid
  shippingQuoteSnapshot Json?
  packagingSnapshot  Json?
  shippingOriginSnapshot Json?
  shippedAt           DateTime?
  status              OrderStatus           @default(PENDING)
  currency            String                @default("AUD")
  subtotalCents       Int
  shippingCents       Int                   @default(0)
  totalCents          Int
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  user                User?                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  store               Store                 @relation(fields: [storeId], references: [id], onDelete: Restrict)
  shippingAddress     Address?              @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  payments            Payment[]
  statusHistory       OrderStatusHistory[]
  inventoryMovements  InventoryMovement[]
  shippingQuote       ShippingQuote?        @relation(fields: [shippingQuoteId], references: [id], onDelete: SetNull)
  shipments           Shipment[]

  @@index([storeId, userId, createdAt])
  @@index([storeId, guestEmail, createdAt])
  @@index([storeId, status, createdAt])
  @@index([trackingNumber])
}

model OrderItem {
  id                String             @id @default(uuid()) @db.Uuid
  orderId           String             @db.Uuid
  variantId         String             @db.Uuid
  quantity          Int
  unitPriceCents    Int
  productName       String
  variantName       String
  sku               String
  productType       ProductType
  personalisation   Json?
  personalisationMode PersonalisationMode @default(NONE)
  personalisationChoice PersonalisationChoice @default(BASIC)
  selectedOptions   Json?
  shippingSnapshot  Json?
  order             Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant           ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Restrict)
  tags              NFCTag[]
  manufacturingJobs ManufacturingJob[]

  @@index([orderId])
}

model OrderStatusHistory {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @db.Uuid
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorId    String?      @db.Uuid
  note       String?
  createdAt  DateTime     @default(now())
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor      User?        @relation("OrderStatusActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model InventoryMovement {
  id        String                @id @default(uuid()) @db.Uuid
  variantId String                @db.Uuid
  orderId   String?               @db.Uuid
  actorId   String?               @db.Uuid
  type      InventoryMovementType
  quantity  Int
  reason    String?
  createdAt DateTime              @default(now())
  variant   ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Restrict)
  order     Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  actor     User?                 @relation("InventoryActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@index([orderId])
}

model ManufacturingBatch {
  id               String              @id @default(uuid()) @db.Uuid
  batchNumber      String              @unique
  storeId          String              @db.Uuid
  productId        String              @db.Uuid
  productVariantId String?             @db.Uuid
  quantity         Int
  status           ManufacturingStatus @default(GENERATED)
  createdById      String?             @db.Uuid
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  product          Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  store            Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  productVariant   ProductVariant?     @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  createdBy        User?               @relation("ManufacturingCreator", fields: [createdById], references: [id], onDelete: SetNull)
  tags             NFCTag[]

  @@index([storeId, status, createdAt])
  @@index([storeId, productId, createdAt])
}

model ManufacturingJob {
  id               String                 @id @default(uuid()) @db.Uuid
  storeId          String                 @db.Uuid
  orderItemId      String                 @db.Uuid
  productVariantId String                 @db.Uuid
  sequence         Int                    @default(1)
  quantity         Int
  status           ManufacturingJobStatus @default(QUEUED)
  priority         Int                    @default(0)
  material         String?
  colour           String?
  requiresNfc      Boolean                @default(false)
  estimatedMinutes Int?
  actualMinutes    Int?
  qaPassed         Boolean?
  failureReason    String?
  assignedToId     String?                @db.Uuid
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  store            Store                  @relation(fields: [storeId], references: [id], onDelete: Restrict)
  orderItem        OrderItem              @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  productVariant   ProductVariant         @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  assignedTo       User?                  @relation("ManufacturingAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@unique([orderItemId, sequence])
  @@index([storeId, status, priority, createdAt])
  @@index([productVariantId, status])
  @@index([assignedToId, status])
}

model ShippingOrigin {
  id          String   @id @default(uuid()) @db.Uuid
  storeId     String   @db.Uuid
  name        String
  senderName  String
  company     String?
  line1       String
  line2       String?
  suburb      String
  state       String
  postcode    String
  country     String   @default("AU") @db.Char(2)
  phone       String?
  email       String?
  isDefault   Boolean  @default(false)
  active      Boolean  @default(true)
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  createdBy   User?    @relation("ShippingOriginCreator", fields: [createdById], references: [id], onDelete: SetNull)
  shipments   Shipment[]

  @@unique([storeId, name])
  @@index([storeId, active, isDefault])
}

model Packaging {
  id              String   @id @default(uuid()) @db.Uuid
  storeId         String   @db.Uuid
  name            String
  code            String
  lengthMm        Int
  widthMm         Int
  heightMm        Int
  emptyWeightGrams Int     @default(0)
  maxWeightGrams  Int?
  costCents       Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  products        Product[]
  variants        ProductVariant[]
  shippingRates   ShippingRate[]

  @@unique([storeId, code])
  @@index([storeId, active, name])
}

model ShippingZone {
  id             String   @id @default(uuid()) @db.Uuid
  storeId        String   @db.Uuid
  name           String
  countries      String[] @default(["AU"])
  states         String[] @default([])
  postcodeRules  Json     @default("[]")
  priority       Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  rates          ShippingRate[]

  @@unique([storeId, name])
  @@index([storeId, active, priority])
}

model ShippingProvider {
  id             String               @id @default(uuid()) @db.Uuid
  storeId        String               @db.Uuid
  key            String
  name           String
  kind           ShippingProviderKind
  active         Boolean              @default(true)
  supportsRates  Boolean              @default(false)
  supportsLabels Boolean              @default(false)
  settings       Json                 @default("{}")
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  store          Store                @relation(fields: [storeId], references: [id], onDelete: Restrict)
  rates          ShippingRate[]
  shipments      Shipment[]

  @@unique([storeId, key])
  @@index([storeId, active])
}

model ShippingRate {
  id                String   @id @default(uuid()) @db.Uuid
  storeId           String   @db.Uuid
  zoneId            String   @db.Uuid
  providerId        String?  @db.Uuid
  packagingId       String?  @db.Uuid
  serviceCode       String
  serviceName       String
  amountCents       Int
  freeOverCents     Int?
  minWeightGrams    Int?
  maxWeightGrams    Int?
  estimatedDaysMin  Int?
  estimatedDaysMax  Int?
  priority          Int      @default(0)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  store             Store    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  zone              ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  provider          ShippingProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  packaging         Packaging? @relation(fields: [packagingId], references: [id], onDelete: SetNull)

  @@unique([storeId, zoneId, serviceCode, packagingId])
  @@index([storeId, active, priority])
  @@index([zoneId, active])
}

model ShippingQuote {
  id                String              @id @default(uuid()) @db.Uuid
  storeId           String              @db.Uuid
  tokenHash         String              @unique
  status            ShippingQuoteStatus @default(ACTIVE)
  cartHash          String
  destinationHash   String
  providerKey       String
  serviceCode       String
  serviceName       String
  amountCents       Int
  currency          String              @default("AUD") @db.Char(3)
  estimatedDaysMin  Int?
  estimatedDaysMax  Int?
  originSnapshot    Json
  packagingSnapshot Json
  expiresAt         DateTime
  consumedAt        DateTime?
  createdAt         DateTime            @default(now())
  store             Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  order             Order?

  @@index([storeId, status, expiresAt])
}

model Shipment {
  id                  String         @id @default(uuid()) @db.Uuid
  idempotencyKey      String         @unique
  storeId             String         @db.Uuid
  orderId             String         @db.Uuid
  originId            String?        @db.Uuid
  providerId          String?        @db.Uuid
  providerShipmentId  String?
  status              ShipmentStatus @default(DRAFT)
  serviceCode         String
  serviceName         String
  trackingNumber      String?
  trackingUrl         String?
  labelStorageKey     String?
  labelMimeType       String?
  labelCreatedAt      DateTime?
  createdById         String?        @db.Uuid
  shippedAt           DateTime?
  deliveredAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  store               Store          @relation(fields: [storeId], references: [id], onDelete: Restrict)
  order               Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  origin              ShippingOrigin? @relation(fields: [originId], references: [id], onDelete: SetNull)
  provider            ShippingProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  createdBy           User?          @relation("ShipmentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  printJobs           PrintJob[]

  @@index([storeId, status, createdAt])
  @@index([orderId, createdAt])
  @@index([trackingNumber])
}

model PrintAgent {
  id          String   @id @default(uuid()) @db.Uuid
  storeId     String   @db.Uuid
  name        String
  tokenHash   String   @unique
  active      Boolean  @default(true)
  printerName String?
  lastSeenAt  DateTime?
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  createdBy   User?    @relation("PrintAgentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  jobs        PrintJob[]

  @@unique([storeId, name])
  @@index([storeId, active])
}

model PrintJob {
  id           String            @id @default(uuid()) @db.Uuid
  storeId      String            @db.Uuid
  shipmentId   String            @db.Uuid
  printAgentId String?           @db.Uuid
  documentType PrintDocumentType @default(SHIPPING_LABEL)
  status       PrintJobStatus    @default(QUEUED)
  copies       Int               @default(1)
  attempts     Int               @default(0)
  leaseTokenHash String?
  leaseExpiresAt DateTime?
  claimedAt    DateTime?
  printedAt    DateTime?
  failedAt     DateTime?
  errorMessage String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  shipment     Shipment          @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  printAgent   PrintAgent?       @relation(fields: [printAgentId], references: [id], onDelete: SetNull)
  store        Store             @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@index([storeId, status, createdAt])
  @@index([printAgentId, status])
  @@index([leaseExpiresAt])
}

model LandingPageSection {
  id         String             @id @default(uuid()) @db.Uuid
  storeId    String             @db.Uuid
  pageId     String             @db.Uuid
  categoryId String?            @db.Uuid
  type       LandingSectionType
  name       String
  visible    Boolean            @default(true)
  sortOrder  Int                @default(0)
  content    Json               @default("{}")
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  store      Store              @relation(fields: [storeId], references: [id], onDelete: Restrict)
  page       ContentPage        @relation(fields: [pageId], references: [id], onDelete: Cascade)
  category   ProductCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  translations LandingPageSectionTranslation[]

  @@index([storeId, pageId, visible, sortOrder])
  @@index([storeId, categoryId, visible, sortOrder])
}

model ContentPage {
  id             String          @id @default(uuid()) @db.Uuid
  storeId        String          @db.Uuid
  categoryId     String?         @unique @db.Uuid
  kind           ContentPageKind
  slug           String
  name           String
  status         CategoryStatus  @default(DRAFT)
  sortOrder      Int             @default(0)
  defaultLocale  String          @default("en-AU")
  seoTitle       String?
  seoDescription String?
  ogImageUrl     String?
  canonicalUrl   String?
  indexable      Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  store          Store           @relation(fields: [storeId], references: [id], onDelete: Restrict)
  category       ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sections       LandingPageSection[]
  translations   ContentPageTranslation[]
  images         CategoryImage[]

  @@unique([storeId, slug])
  @@index([storeId, kind, status, sortOrder])
}

model ContentPageTranslation {
  id             String      @id @default(uuid()) @db.Uuid
  pageId         String      @db.Uuid
  locale         String
  name           String?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  page           ContentPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, locale])
  @@index([locale])
}

model LandingPageSectionTranslation {
  id        String             @id @default(uuid()) @db.Uuid
  sectionId String             @db.Uuid
  locale    String
  content   Json               @default("{}")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  section   LandingPageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, locale])
  @@index([locale])
}

model StoreLocale {
  id        String   @id @default(uuid()) @db.Uuid
  storeId   String   @db.Uuid
  code      String
  name      String
  isDefault Boolean  @default(false)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, code])
  @@index([storeId, active, sortOrder])
}

model Payment {
  id                      String        @id @default(uuid()) @db.Uuid
  orderId                 String        @db.Uuid
  provider                String        @default("stripe")
  providerPaymentIntentId String?       @unique
  providerSessionId       String?       @unique
  amountCents             Int
  currency                String        @default("AUD")
  status                  PaymentStatus @default(PENDING)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  order                   Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

model NFCTag {
  id                          String              @id @default(uuid()) @db.Uuid
  publicTagId                 String              @unique @db.VarChar(24)
  storeId                     String              @db.Uuid
  activationCodeHash          String
  activationCodeVersion       Int                 @default(1)
  activationCodeRegeneratedAt DateTime?
  activationLockedUntil       DateTime?
  ownerId                     String?             @db.Uuid
  productId                   String              @db.Uuid
  productVariantId            String?             @db.Uuid
  orderItemId                 String?             @db.Uuid
  productType                 ProductType
  status                      TagStatus           @default(MANUFACTURED)
  manufacturingStatus         ManufacturingStatus @default(GENERATED)
  manufacturingBatchId        String?             @db.Uuid
  batchSequence               Int?
  programmedAt                DateTime?
  verifiedAt                  DateTime?
  assembledAt                 DateTime?
  activatedAt                 DateTime?
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
  owner                       User?               @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  store                       Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product                     Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  productVariant              ProductVariant?     @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  orderItem                   OrderItem?          @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  manufacturingBatch          ManufacturingBatch? @relation(fields: [manufacturingBatchId], references: [id], onDelete: SetNull)
  activations                 TagActivation[]
  profile                     TagProfile?
  scans                       ScanEvent[]

  @@unique([manufacturingBatchId, batchSequence])
  @@index([storeId, ownerId, status])
  @@index([storeId, productId, status])
  @@index([orderItemId])
  @@index([manufacturingStatus, createdAt])
}

model TagActivation {
  id          String   @id @default(uuid()) @db.Uuid
  tagId       String   @db.Uuid
  userId      String?  @db.Uuid
  success     Boolean
  ipHash      String?
  attemptedAt DateTime @default(now())
  tag         NFCTag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@index([tagId, attemptedAt])
  @@index([ipHash, attemptedAt])
}

model TagProfile {
  id          String             @id @default(uuid()) @db.Uuid
  tagId       String             @unique @db.Uuid
  displayName String?
  isPublic    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  tag         NFCTag             @relation(fields: [tagId], references: [id], onDelete: Cascade)
  pet         PetProfile?
  child       ChildProfile?
  social      SocialProfile?
  business    BusinessProfile?
  luggage     LuggageProfile?
  contacts    EmergencyContact[]
}

model PetProfile {
  id             String     @id @default(uuid()) @db.Uuid
  tagProfileId   String     @unique @db.Uuid
  photoUrl       String?
  species        String?
  breed          String?
  sex            String?
  approximateAge String?
  description    String?
  medicalInfo    String?
  allergies      String?
  medications    String?
  behaviourNotes String?
  veterinarian   String?
  tagProfile     TagProfile @relation(fields: [tagProfileId], references: [id], onDelete: Cascade)
}

model ChildProfile {
  id                  String      @id @default(uuid()) @db.Uuid
  tagProfileId        String      @unique @db.Uuid
  photoUrl            String?
