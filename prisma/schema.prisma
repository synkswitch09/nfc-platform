  tagProfile   TagProfile @relation(fields: [tagProfileId], references: [id], onDelete: Cascade)
}

model BusinessProfile {
  id           String     @id @default(uuid()) @db.Uuid
  tagProfileId String     @unique @db.Uuid
  company      String?
  jobTitle     String?
  phone        String?
  email        String?
  website      String?
  linkedIn     String?
  socialLinks  Json       @default("{}")
  bio          String?
  tagProfile   TagProfile @relation(fields: [tagProfileId], references: [id], onDelete: Cascade)
}

model LuggageProfile {
  id           String     @id @default(uuid()) @db.Uuid
  tagProfileId String     @unique @db.Uuid
  message      String?
  contactName  String?
  contactPhone String?
  contactEmail String?
  tagProfile   TagProfile @relation(fields: [tagProfileId], references: [id], onDelete: Cascade)
}

model EmergencyContact {
  id           String     @id @default(uuid()) @db.Uuid
  tagProfileId String     @db.Uuid
  name         String
  relationship String?
  phone        String
  priority     Int        @default(0)
  tagProfile   TagProfile @relation(fields: [tagProfileId], references: [id], onDelete: Cascade)

  @@index([tagProfileId, priority])
}

model ScanEvent {
  id             BigInt   @id @default(autoincrement())
  tagId          String   @db.Uuid
  scannedAt      DateTime @default(now())
  dayBucket      DateTime @db.Date
  deviceCategory String?
  countryCode    String?  @db.Char(2)
  region         String?
