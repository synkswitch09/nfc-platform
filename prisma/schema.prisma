generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum ProductType {
  PET
  CHILD
  SOCIAL
  BUSINESS
  LUGGAGE
}

enum TagStatus {
  MANUFACTURED
  UNCLAIMED
  ACTIVE
  DISABLED
  LOST
  REPLACED
}

enum ChildStatus {
  NORMAL
  MISSING
}

enum SocialMode {
  DIRECT_REDIRECT
  MULTI_LINK
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model User {
  id              String   @id @default(uuid()) @db.Uuid
  email           String   @unique
  passwordHash    String
  name            String
  phone           String?
  role            Role     @default(CUSTOMER)
  emailVerifiedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  addresses       Address[]
  orders          Order[]
  tags            NFCTag[]
  sessions        Session[]
  auditLogs       AuditLog[]
  emailTokens     EmailVerification[]
  passwordResets  PasswordReset[]
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  lastSeen  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model EmailVerification {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  usedAt    DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model PasswordReset {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  usedAt    DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model Address {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  label      String?
  recipient  String
  line1      String
  line2      String?
  suburb     String
  state      String
  postcode   String
  country    String   @default("AU")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders     Order[]
  @@index([userId])
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  slug        String        @unique
  name        String
  description String
  type        ProductType
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  variants    ProductVariant[]
  tags        NFCTag[]
}

model ProductVariant {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @db.Uuid
  sku         String   @unique
  name        String
  colour      String?
  priceCents  Int
  inventory   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderItems  OrderItem[]
  tags        NFCTag[]
  @@index([productId, active])
}

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  orderNumber     String      @unique
  userId          String      @db.Uuid
  shippingAddressId String?    @db.Uuid
  status          OrderStatus @default(PENDING)
  currency        String      @default("AUD")
  subtotalCents   Int
  shippingCents   Int         @default(0)
  totalCents      Int
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  shippingAddress Address?     @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  payments        Payment[]
  @@index([userId, createdAt])
}

model OrderItem {
  id              String   @id @default(uuid()) @db.Uuid
  orderId         String   @db.Uuid
  variantId       String   @db.Uuid
  quantity        Int
  unitPriceCents  Int
  personalisation Json?
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  @@index([orderId])
}

model Payment {
  id                      String        @id @default(uuid()) @db.Uuid
  orderId                 String        @db.Uuid
  provider                String        @default("stripe")
  providerPaymentIntentId String?       @unique
  providerSessionId       String?       @unique
  amountCents             Int
  currency                String        @default("AUD")
  status                  PaymentStatus @default(PENDING)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  order                   Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  @@index([orderId])
}

model NFCTag {
  id                 String      @id @default(uuid()) @db.Uuid
  publicTagId        String      @unique @db.VarChar(24)
  activationCodeHash String
  ownerId            String?     @db.Uuid
  productId          String      @db.Uuid
  productVariantId   String?     @db.Uuid
  productType        ProductType
  status             TagStatus   @default(MANUFACTURED)
  activatedAt        DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  owner              User?       @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  product            Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  productVariant     ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  activations        TagActivation[]
  profile            TagProfile?
  scans              ScanEvent[]
  @@index([ownerId, status])
  @@index([productId, status])
}

model TagActivation {
  id            String   @id @default(uuid()) @db.Uuid
  tagId         String   @db.Uuid
  userId        String?  @db.Uuid
  success       Boolean
  ipHash        String?
  attemptedAt   DateTime @default(now())
  tag           NFCTag   @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@index([tagId, attemptedAt])
  @@index([ipHash, attemptedAt])
}

model TagProfile {
  id          String   @id @default(uuid()) @db.Uuid
  tagId       String   @unique @db.Uuid
  displayName String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tag         NFCTag   @relation(fields: [tagId], references: [id], onDelete: Cascade)
  pet         PetProfile?
  child       ChildProfile?
  social      SocialProfile?
  business    BusinessProfile?
  luggage     LuggageProfile?
  contacts    EmergencyContact[]
}

model PetProfile {
  id             String   @id @default(uuid()) @db.Uuid
  tagProfileId   String   @unique @db.Uuid
  photoUrl       String?
  species        String?
  breed          String?
  sex            String?
  approximateAge String?
  description    String?
  medicalInfo    String?
  allergies      String?
  medications    String?
  behaviourNotes String?
  veterinarian   String?
  tagProfile     TagProfile @relation(fields: [tagProfileId], references: [id], onDelete: Cascade)
}

model ChildProfile {
  id                    String      @id @default(uuid()) @db.Uuid
  tagProfileId          String      @unique @db.Uuid
  photoUrl              String?
  approximateAge        String?
  criticalMedicalInfo   String?
  allergies             String?
  communicationNotes    String?
  status                ChildStatus @default(NORMAL)
  tagProfile            TagProfile  @relation(fields: [tagProfileId], references: [id], onDelete: Cascade)
}

model SocialProfile {
  id             String     @id @default(uuid()) @db.Uuid
  tagProfileId   String     @unique @db.Uuid
  mode           SocialMode @default(MULTI_LINK)
  redirectUrl    String?
  links          Json       @default("{}")
  bio            String?
  tagProfile     TagProfile @relation(fields: [tagProfileId], references: [id], onDelete: Cascade)
}

model BusinessProfile {
  id           String   @id @default(uuid()) @db.Uuid
  tagProfileId String   @unique @db.Uuid
  company      String?
  jobTitle     String?
  phone        String?
  email        String?
  website      String?
  linkedIn     String?
  socialLinks  Json     @default("{}")
  bio          String?
  tagProfile   TagProfile @relation(fields: [tagProfileId], references: [id], onDelete: Cascade)
}

model LuggageProfile {
  id             String   @id @default(uuid()) @db.Uuid
  tagProfileId   String   @unique @db.Uuid
  message        String?
  contactName    String?
  contactPhone   String?
  contactEmail   String?
  tagProfile     TagProfile @relation(fields: [tagProfileId], references: [id], onDelete: Cascade)
}

model EmergencyContact {
  id           String   @id @default(uuid()) @db.Uuid
  tagProfileId String   @db.Uuid
  name         String
  relationship String?
  phone        String
  priority     Int      @default(0)
  tagProfile   TagProfile @relation(fields: [tagProfileId], references: [id], onDelete: Cascade)
  @@index([tagProfileId, priority])
}

model ScanEvent {
  id             BigInt   @id @default(autoincrement())
  tagId          String   @db.Uuid
  scannedAt      DateTime @default(now())
  dayBucket      DateTime @db.Date
  deviceCategory String?
  countryCode    String?  @db.Char(2)
  region         String?
  tag            NFCTag   @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@index([tagId, scannedAt])
  @@index([tagId, dayBucket])
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

model WebhookEvent {
  id          String   @id
  provider    String
  eventType   String
  processedAt DateTime @default(now())
}

model SecurityEvent {
  id        BigInt   @id @default(autoincrement())
  keyHash   String
  action    String
  createdAt DateTime @default(now())
  @@index([keyHash, action, createdAt])
}
