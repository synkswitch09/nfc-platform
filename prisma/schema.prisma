  supportEmail          String?
  currency              String   @default("AUD")
  defaultCountry        String   @default("AU")
  siteTitle             String   @default("Tapkin Smart Products")
  siteDescription       String   @default("Smart NFC products designed and made in Australia.")
  defaultSocialImageUrl String?
  socialLinks           Json     @default("{}")
