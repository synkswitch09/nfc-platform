APP_ENV="development"
POSTGRES_PASSWORD="replace-with-a-random-database-password"
DATABASE_URL="postgresql://nfc:replace-with-the-same-database-password@localhost:5432/nfc_platform?schema=public"
DATABASE_EXPECTED_NAME="nfc_platform"
APP_URL="http://localhost:3000"
SESSION_SECRET="replace-with-at-least-32-random-characters"
ACTIVATION_PEPPER="replace-with-a-different-random-secret"
TRUST_PROXY="false"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# At least 32 random characters; used only by the checkout reconciliation scheduler.
CHECKOUT_RECONCILE_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
EMAIL_WEBHOOK_URL=""
EMAIL_WEBHOOK_SECRET=""
ENABLE_TEST_CHECKOUT="false"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
# Etsy Open API v3 (optional). Register ${APP_URL}/api/admin/etsy/callback as
# the exact HTTPS callback URL in the Etsy developer application.
ETSY_API_KEY=""
ETSY_SHARED_SECRET=""
# Separate random bearer secret for the scheduled Etsy sync endpoint.
ETSY_SYNC_SECRET=""
UPLOAD_DIR="./data/uploads"
# Optional in production. One distinct GA4 web stream and secret per store;
# never put these credentials in NEXT_PUBLIC_* or the CMS.
ANALYTICS_GA4_STORES='{}'
LOG_LEVEL="info"
# Set only temporarily while running npm run db:seed in DEVELOPMENT.
DEV_ADMIN_EMAIL=""
DEV_ADMIN_PASSWORD=""
# STAGING only: also requires ALLOW_STAGING_SEED=true for the seed command.
ALLOW_STAGING_SEED="false"
STAGING_ADMIN_EMAIL=""
STAGING_ADMIN_PASSWORD=""
STORAGE_PROVIDER="local"
STORAGE_ENVIRONMENT="development"
AZURE_STORAGE_CONTAINER_URL=""
AZURE_STORAGE_SAS_TOKEN=""
EMAIL_MODE="mock"
# Local print agent process only. Keep its one-time token outside the web app environment.
TAPKIN_PRINT_AGENT_URL="http://localhost:3000"
TAPKIN_PRINT_AGENT_TOKEN=""
TAPKIN_PRINT_COMMAND=""
TAPKIN_PRINT_ARGS_JSON='["{file}"]'
TAPKIN_PRINTER_NAME=""
