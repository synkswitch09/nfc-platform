{
  "name": "nfc-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "oxlint . --deny-warnings --disable-unicorn-plugin",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e-http.mjs",
    "config:check": "node --import tsx scripts/check-config.ts",
    "smoke": "node scripts/smoke.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "print-agent": "node scripts/print-agent.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bcryptjs": "latest",
    "lucide-react": "latest",
    "next": "16.3.5",
    "openid-client": "6.8.1",
    "qrcode": "latest",
    "react": "latest",
    "react-dom": "latest",
    "stripe": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/qrcode": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "oxlint": "1.82.0",
    "prisma": "6.19.0",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
